# Persistent PostgreSQL storage (Neon recommended for the free MVP)
DATABASE_URL=postgresql://user:password@host:5432/streetlens
DATABASE_SSL=true

# Optional source/API credentials
STREETLENS_REFRESH_TOKEN=replace-with-a-long-random-token
GOOGLE_MAPS_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
GEMINI_API_KEY=

# Environmental Ministry official national AQI API (server only)
MOENV_API_KEY=

# Private housing only; server-side values, NEVER VITE_* or refresh-token reuse.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STREETLENS_OWNER_EMAIL=
# Required for non-Gmail owner accounts; optional extra restriction for Gmail.
STREETLENS_OWNER_GOOGLE_SUB=
# Preferred multi-account whitelist (comma-separated). When set, replaces legacy owner fields.
# Empty/invalid whitelist disables private access. Keep actual emails out of Git.
# STREETLENS_PRIVATE_EMAILS=first@gmail.com,second@gmail.com
# Optional JSON email-to-Google-subject pins; required for non-Gmail accounts.
# STREETLENS_PRIVATE_GOOGLE_SUBS={"person@example.com":"stable-google-subject"}
STREETLENS_PUBLIC_ORIGIN=https://streetlens-fokj.onrender.com
