# Persistent external-data storage
# Option A: Cloud SQL Unix socket (recommended when deployed with Cloud SQL integration)
CLOUD_SQL_CONNECTION_NAME=project:region:instance
INSTANCE_UNIX_SOCKET=/cloudsql/project:region:instance
DB_USER=streetlens
DB_PASSWORD=replace-with-db-password
DB_NAME=streetlens
DB_PORT=5432

# Option B: PostgreSQL connection string (useful for local TCP / Cloud SQL public IP)
DATABASE_URL=postgresql://user:password@host:5432/streetlens
DATABASE_SSL=true
STREETLENS_REFRESH_TOKEN=replace-with-a-long-random-token
GOOGLE_MAPS_API_KEY=
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=
GEMINI_API_KEY=
